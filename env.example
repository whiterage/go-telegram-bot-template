# Bot configuration
BOT_TOKEN=your_bot_token_here
APP_ENV=dev

# Admin configuration
ADMIN_IDS=admin_user_id1,admin_user_id2

# Channel configuration
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/your_channel

# Board configuration
BOARD_CHAT_ID=-1001234567890
INPROGRESS_TOPIC_ID=123
PAID_TOPIC_ID=124
DONE_TOPIC_ID=125
DEADLINE_TOPIC_ID=126

# Optional settings
ALLOW_ADMINS_BYPASS=true

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=tgbot
DB_SSLMODE=disable

# Webhook (optional, getUpdates is used by default)
# USE_WEBHOOK=false  # or omit - getUpdates will be used (recommended for production)
# USE_WEBHOOK=true   # to use webhook mode
# WEBHOOK_URL=https://your.domain.tld/telegram/webhook
# WEBHOOK_SECRET=some-long-random-secret
# WEBHOOK_ADDR=:8080      # local http server in container/on VM
# WEBHOOK_PATH=/telegram/webhook

# FAQ URL (optional)
# FAQ_URL=https://your-faq-page.com
