# Bot configuration
BOT_TOKEN=your_bot_token_here
APP_ENV=dev

# Admin configuration
ADMIN_IDS=admin_user_id1,admin_user_id2

# Channel subscription gate
# REQUIRE_SUBSCRIPTION=false полностью отключает проверку подписки;
# в этом случае CHANNEL_ID и CHANNEL_URL можно не заполнять.
REQUIRE_SUBSCRIPTION=true
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/your_channel

# Board configuration
BOARD_CHAT_ID=-1001234567890
INPROGRESS_TOPIC_ID=123
PAID_TOPIC_ID=124
DONE_TOPIC_ID=125
DEADLINE_TOPIC_ID=126

# Optional settings
ALLOW_ADMINS_BYPASS=true

# Database (SQLite - обычный файл на диске, отдельная СУБД не нужна)
# Локально можно не указывать: по умолчанию ./data.db
# В Docker путь задаётся в docker-compose.yml -> /app/data/data.db
# DB_PATH=data.db

# Часовой пояс (влияет на дедлайны и еженедельные отчёты по понедельникам в 9:00)
TZ=Europe/Moscow

# Webhook (optional, getUpdates is used by default)
# USE_WEBHOOK=false  # or omit - getUpdates will be used (recommended for production)
# USE_WEBHOOK=true   # to use webhook mode
# WEBHOOK_URL=https://your.domain.tld/telegram/webhook
# WEBHOOK_SECRET=some-long-random-secret
# WEBHOOK_ADDR=:8080      # local http server in container/on VM
# WEBHOOK_PATH=/telegram/webhook

# FAQ URL (optional)
# FAQ_URL=https://your-faq-page.com
